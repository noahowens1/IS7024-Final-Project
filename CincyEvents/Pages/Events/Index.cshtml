@page
@model CincyEvents.Pages.Events.IndexModel
@{
    ViewData["Title"] = "Events";
}

<h1>Events</h1>
<p>Connect to an event to join its group chat and message other attendees.</p>

<div class="row g-4">
    @foreach (var eventItem in Model.Events)
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5">@eventItem.Name</h2>
                    <p>@eventItem.Description</p>
                    <p><small>Starts @eventItem.StartsAt.ToLocalTime().ToString("f")</small></p>
                    @if (eventItem.IsConnected)
                    {
                        <a class="btn btn-primary" asp-page="/Chat/Index" asp-route-eventId="@eventItem.Id">Open chat</a>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Join">
                            <input type="hidden" name="eventId" value="@eventItem.Id" />
                            <button class="btn btn-outline-primary" type="submit">Connect to event</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>
