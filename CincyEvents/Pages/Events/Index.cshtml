@page
@model CincyEvents.Pages.Events.IndexModel
@{
    ViewData["Title"] = "Upcoming Events";
}

<h1>Upcoming Events</h1>
<p>Browse the small event catalog and save events you'd like to remember.</p>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info" role="status" aria-live="polite">@Model.StatusMessage</div>
}

@if (Model.UpcomingEvents.Any(@event => @event.IsSample))
{
    <p class="alert alert-warning">Sample event - not live event information.</p>
}

@if (Model.UpcomingEvents.Count == 0)
{
    <p>No upcoming events are currently available.</p>
}
else
{
    <div class="row g-3">
        @foreach (var @event in Model.UpcomingEvents)
        {
            <div class="col-12 col-md-6">
                <article class="card h-100">
                    <div class="card-body">
                        <h2 class="h5 card-title">@(@event.Title)</h2>
                        @if (@event.IsSample)
                        {
                            <span class="badge bg-warning text-dark">Sample event - not live event information</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(@event.Category))
                        {
                            <p class="card-text mt-2">@(@event.Category)</p>
                        }
                        <p class="card-text">
                            @CincyEvents.Services.EventTimeFormatter.Format(@event.StartAtUtc, @event.TimeZoneId)
                            @if (!string.IsNullOrWhiteSpace(@event.Venue))
                            {
                                <span> · @(@event.Venue)</span>
                            }
                        </p>
                        <form method="post" asp-page="/SavedEvents/Save" asp-route-eventId="@(@event.Id)" asp-route-returnUrl="/Events">
                            <button type="submit" class="btn btn-primary">Save Event</button>
                        </form>
                    </div>
                </article>
            </div>
        }
    </div>
}
