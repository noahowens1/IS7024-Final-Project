@page "/Categories/{id}"
@model DetailsModel
@{
    ViewData["Title"] = Model.Category?.Title ?? "Category";
}

@if (Model.Category is not null)
{
    <article>
        <h1>@Model.Category.Title</h1>
        <p class="lead">@Model.Category.Description</p>

        <a class="btn btn-outline-primary"
           asp-page="/Categories/Index">
            Back to categories
        </a>
    </article>
}