@page
@model CincyEvents.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Categories";
}

<h1 class="mb-3">Event Categories</h1>

<p class="lead mb-4">
    Explore Cincinnati events by category and find
    activities that match your interests.
</p>

<div class="row g-4">
    @foreach (var category in Model.Categories)
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">

                    <h4 class="card-title">
                        @category.Title
                    </h4>

                    <p class="card-text">
                        @category.Description
                    </p>

                    <a asp-page="/Categories/Details"
                       asp-route-id="@category.Id"
                       class="btn btn-primary mt-auto">
                        Explore Events
                    </a>

                </div>
            </div>
        </div>
    }
</div>
